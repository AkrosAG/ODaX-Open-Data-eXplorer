if 'transformer' not in globals():
    from mage_ai.data_preparation.decorators import transformer
if 'test' not in globals():
    from mage_ai.data_preparation.decorators import test


@transformer
def transform(data, *args, **kwargs):
    """
    Transform the station data by renaming columns to more standard names
    """
    
    # return data
    rename_map = {
        "Station": "name",
        "Tag": "short_code", 
        "Easting": "lv95_easting",
        "Northing": "lv95_northing",
        "Meters_Above_Sealevel": "elevation_m",
        "Locationtype": "location_type",
        "Remarks": "remarks",
    }
    
    # Rename columns
    data = data.rename(columns=rename_map)
    
    # Replace hyphens with empty string in station names
    data['name'] = data['name'].str.replace('-', '', regex=False)
    
    return data


@test
def test_output(output, *args) -> None:
    """
    Template code for testing the output of the block.
    """
    assert output is not None, 'The output is undefined'